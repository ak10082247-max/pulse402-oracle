    "/v1/pulse/base-liquidity": {
      "get": {
        "summary": "Get Base Liquidity",
        "operationId": "get_base_liquidity_v1_pulse_base_liquidity_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "402": {
            "description": "Verified x402 payment or purchased credit required."
          },
          "503": {
            "description": "Fresh fulfillment unavailable or settlement requires recovery; inspect charged field before retrying."
          }
        },
        "description": "Base token liquidity observations, measured pool balance changes after warm-up, and unsigned amount-specific USDC quotes for $100, $1,000 and $10,000, pinned to one verified Base block. Coverage and quote provenance are included.",
