  "components": {
    "securitySchemes": {
      "x402PaymentSignature": {
        "type": "apiKey",
        "name": "X-PAYMENT",
        "in": "header",
        "description": "Base64-encoded x402 payment signature (EIP-712 TransferWithAuthorization on Base or SPL TransferChecked on Solana)"
      },
      "pulseSession": {
        "type": "apiKey",
        "name": "X-Pulse-Session",
        "in": "header",
        "description": "Purchased session token; use a unique Idempotency-Key per delivery and reuse it for retries."
      }
    }
