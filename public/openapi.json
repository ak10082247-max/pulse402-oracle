          {
            "x402PaymentSignature": []
          },
          {
            "pulseSession": []
          }
        ],
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Optional token symbol to filter (e.g. WETH, AERO, DEGEN, VIRTUAL)"
            }
          }
        ]
      }
    },
